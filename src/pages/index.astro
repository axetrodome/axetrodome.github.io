---
import '../styles/global.css';

const formatMonth = (date) => new Intl.DateTimeFormat('en-US', { month: 'short' }).format(date);

function getDurationParts(startDate, endDate = new Date()) {
  const start = new Date(startDate);
  const end = new Date(endDate);

  let years = end.getFullYear() - start.getFullYear();
  let months = end.getMonth() - start.getMonth();

  if (end.getDate() < start.getDate()) {
    months -= 1;
  }

  if (months < 0) {
    years -= 1;
    months += 12;
  }

  return { years, months };
}

function formatDuration(startDate, endDate = new Date()) {
  const { years, months } = getDurationParts(startDate, endDate);

  if (years === 0) {
    return `${months} ${months === 1 ? 'mo' : 'mos'}`;
  }

  if (months === 0) {
    return `${years}+ years`;
  }

  if (months >= 6) {
    return `${years} and a half years`;
  }

  return `${years}+ years`;
}

const experience = [
  {
    role: 'Application Development Analyst',
    company: 'Accenture in the Philippines',
    type: 'Full-time',
    start: '2023-08-01',
    end: new Date(),
    location: 'Hybrid · NCR, Philippines',
    bullets: [
      'Maintained and enhanced enterprise HR applications built on .NET Core, C#, AngularJS, and Microsoft SQL Server.',
      'Resolved production issues, reduced downtime, and improved system reliability for business users.',
      'Collaborated with stakeholders to translate business requirements into clear system improvements.',
      'Worked with React, .NET Core, and Entity Framework for internal development initiatives and feature work.'
    ],
    tech: ['.NET Core', 'C#', 'AngularJS', 'Microsoft SQL Server', 'Entity Framework']
  },
  {
    role: 'Web Developer',
    company: 'Cafe24 Philippines',
    type: 'Full-time',
    start: '2019-05-01',
    end: '2023-06-30',
    location: 'On-site · Pasig, Philippines',
    bullets: [
      'Built and maintained web applications using Laravel, PHP, Docker, jQuery, and ReactJS for e-commerce clients.',
      'Integrated third-party APIs for real-time shipping and order tracking workflows.',
      'Created internal tools using Jira and Wiki APIs to automate developer reporting.',
      'Worked closely with product and design teams to ship clean, user-friendly functionality.'
    ],
    tech: ['Laravel', 'PHP', 'Docker', 'ReactJS', 'jQuery', 'JavaScript']
  }
].map((job) => ({
  ...job,
  duration: formatDuration(job.start, job.end),
  dateLabel: `${formatMonth(new Date(job.start))} ${new Date(job.start).getFullYear()} - ${job.end instanceof Date && job.end.toDateString() === new Date().toDateString() ? 'Present' : formatMonth(new Date(job.end)) + ' ' + new Date(job.end).getFullYear()}`
}));

const totalExperience = formatDuration('2019-05-01', new Date());

const stats = [
  { label: 'Experience', value: totalExperience },
  { label: 'Stack', value: '.NET + JS' },
  { label: 'Focus', value: 'Business apps' }
];

const focusAreas = [
  {
    name: 'Enterprise systems',
    summary: 'Maintaining and improving internal tools and business-critical applications used by real teams every day.',
    stack: ['C#', '.NET Core', 'AngularJS', 'SQL Server']
  },
  {
    name: 'Performance & stability',
    summary: 'Troubleshooting production issues and improving reliability so users can work without interruption.',
    stack: ['Debugging', 'Incident support', 'SLA follow-through']
  },
  {
    name: 'Web development',
    summary: 'Creating clean, responsive interfaces and backend logic for real business workflows.',
    stack: ['Laravel', 'ReactJS', 'jQuery', 'JavaScript']
  },
  {
    name: 'Automation & integrations',
    summary: 'Connecting systems and reducing manual process overhead through API-driven workflows.',
    stack: ['APIs', 'Reporting', 'Workflow automation']
  }
];

const stackGroups = [
  {
    label: 'Backend',
    items: ['C#', '.NET Core', '.NET Framework', 'PHP', 'Laravel']
  },
  {
    label: 'Frontend',
    items: ['JavaScript', 'ReactJS', 'VueJS', 'jQuery', 'AngularJS', 'HTML', 'CSS']
  },
  {
    label: 'Database',
    items: ['Microsoft SQL Server', 'MySQL']
  },
  {
    label: 'Tools & workflows',
    items: ['REST APIs', 'ServiceNow', 'Git', 'Docker', 'Jira', 'Wiki']
  }
];
